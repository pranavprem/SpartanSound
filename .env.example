# Copy to .env for a host PHP server. Docker Compose reads this file too.
# The values below match the local defaults in docker-compose.yml.
# They are throwaway development settings, not a deployed password.
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=spartanuser
DB_PASSWORD=devpassword
DB_NAME=spartansound
DB_CONNECT_RETRIES=5
