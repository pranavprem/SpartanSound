root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true

[*.{php,css,js,yml,json,sql}]
indent_style = space
indent_size = 4

[*.{yml,yaml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false
indent_size = 2

[*.{jpg,jpeg,png,gif,ico,mp3,woff,ttf,eot,otf,svg}]
charset = unset
end_of_line = unset
insert_final_newline = unset
trim_trailing_whitespace = unset
